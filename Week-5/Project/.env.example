# Copy this file to .env. Keep real API keys out of source control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODE=mock
PROMPT_STYLE=instruction

# Hybrid decision policy
ML_CONFIDENCE_THRESHOLD=0.65
GEMINI_CONFIDENCE_THRESHOLD=0.65

# Optional CSV download settings (dataset source, terms, and license are your responsibility)
TICKET_DATASET_URL=https://datasets-server.huggingface.co/rows?dataset=yadavmana%2Fcustomer-support-tickets&config=default&split=train&offset=0&length=100
DATASET_SOURCE_NAME=yadavmana/customer-support-tickets
DATASET_LICENSE=CC-BY-NC-4.0

